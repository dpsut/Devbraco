<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <style>
        :root { color-scheme: light dark; --ink: #1c1917; --muted: #57534e; --line: #d6d3d1; --paper: #fafaf9; --accent: #1d4e4a; --danger: #9f1239; }
        @@media (prefers-color-scheme: dark) {
            :root { --ink: #fafaf9; --muted: #a8a29e; --line: #44403c; --paper: #1c1917; --accent: #5eead4; --danger: #fda4af; }
        }
        body { margin: 0; font-family: "Segoe UI", sans-serif; color: var(--ink); background: var(--paper); }
        main { max-width: 38rem; margin: 0 auto; padding: 2.5rem 1.25rem 4rem; }
        h1 { font-size: 1.75rem; font-weight: 650; letter-spacing: -0.02em; margin: 0 0 0.25rem; }
        .progress { color: var(--muted); margin: 0 0 1.5rem; }
        .intro { margin: 0 0 1.5rem; }
        label { display: block; font-weight: 600; margin-bottom: 0.35rem; }
        .field { margin: 0 0 1.25rem; }
        input { width: 100%; box-sizing: border-box; font: inherit; padding: 0.6rem 0.7rem; border: 1px solid var(--line); border-radius: 0.4rem; background: transparent; color: inherit; }
        .help, .error { margin: 0.35rem 0 0; font-size: 0.92rem; }
        .help { color: var(--muted); }
        .error { color: var(--danger); }
        button { font: inherit; background: var(--accent); color: #fafaf9; border: 0; border-radius: 0.4rem; padding: 0.65rem 1rem; cursor: pointer; }
        .toolbar { border-top: 1px solid var(--line); margin-top: 2.5rem; padding-top: 1rem; color: var(--muted); font-size: 0.85rem; }
        .toolbar a { color: inherit; }
        code { font-size: 0.92em; }
    </style>
</head>
<body>
    <main>
        @RenderBody()
    </main>
</body>
</html>
